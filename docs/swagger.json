{
    "swagger": "2.0",
    "info": {
        "description": "Outbound SIM800C calling API for CSV lead import, status, and interested leads.",
        "title": "AutoCall API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/autocall/init": {
            "post": {
                "description": "Upload a CSV with fullname, company, and phone number columns. Duplicate phone numbers are skipped.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "autocall"
                ],
                "summary": "Import leads from CSV",
                "parameters": [
                    {
                        "type": "file",
                        "description": "CSV file",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api_controller.InitImportResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api_controller.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api_controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/autocall/leads": {
            "get": {
                "description": "Returns leads that pressed DTMF 1 (status interested) from PostgreSQL.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "autocall"
                ],
                "summary": "List interested leads",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api_controller.LeadsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api_controller.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/autocall/status": {
            "get": {
                "description": "Returns lead counts by status and the current calling lead when applicable.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "autocall"
                ],
                "summary": "Get calling status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api_controller.StatusResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api_controller.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api_controller.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "api_controller.InitImportData": {
            "type": "object",
            "properties": {
                "errors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/core_pkg_csv.RowError"
                    }
                },
                "failed": {
                    "type": "integer"
                },
                "inserted": {
                    "type": "integer"
                },
                "rowsProcessed": {
                    "type": "integer"
                },
                "skipped": {
                    "type": "integer"
                }
            }
        },
        "api_controller.InitImportResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/api_controller.InitImportData"
                }
            }
        },
        "api_controller.LeadsResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/core_internal_model.Lead"
                    }
                }
            }
        },
        "api_controller.StatusData": {
            "type": "object",
            "properties": {
                "calling": {
                    "type": "integer"
                },
                "completed": {
                    "type": "integer"
                },
                "current_lead": {
                    "$ref": "#/definitions/core_internal_model.Lead"
                },
                "failed": {
                    "type": "integer"
                },
                "interested": {
                    "type": "integer"
                },
                "pending": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "api_controller.StatusResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/api_controller.StatusData"
                }
            }
        },
        "core_internal_model.Lead": {
            "type": "object",
            "properties": {
                "company": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "error": {
                    "type": "string"
                },
                "fullName": {
                    "type": "string"
                },
                "googleSheetSynced": {
                    "type": "boolean"
                },
                "id": {
                    "type": "string"
                },
                "phoneNumber": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updatedAt": {
                    "type": "string"
                }
            }
        },
        "core_pkg_csv.RowError": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                },
                "row": {
                    "type": "integer"
                }
            }
        }
    }
}